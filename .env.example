# Copia este archivo a .env para desarrollo local (NUNCA subas .env al repo,
# ya esta en .gitignore). En Railway, estas mismas variables se configuran
# en Settings > Variables del servicio, no en un archivo.

# --- WhatsApp / Meta ---
# VERIFY_TOKEN es un valor que tu mismo inventas (ver conversacion del caso
# de estudio) -- debe coincidir con lo que escribas en el formulario de
# configuracion del webhook en Meta for Developers.
VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_TOKEN_ID=

# --- Groq (modelo conversacional + Llama Guard) ---
GROQ_API_KEY=
# Opcionales: si se omiten, se usan los defaults en app/config.py
MODELO_CONVERSACIONAL=llama-3.1-8b-instant
MODELO_LLAMA_GUARD=llama-guard-3-8b

# --- Supabase / Postgres (RAG + estado) ---
# Usa la cadena de conexion "Session pooler" de Supabase, con la contrasena
# real sustituida (sin corchetes).
SUPABASE_DB_URL=

# --- Prompt Guard (opcional) ---
# Requiere aceptar la licencia del modelo en Hugging Face y generar un token
# de acceso. Si se deja vacio, el agente sigue funcionando solo con Llama Guard.
HF_TOKEN=

# --- RAG ---
# Calibrado en el notebook original (0.56). Solo cambiar despues de correr
# scripts/evaluar_umbral.py con un contenido nuevo en DOCUMENTOS.
UMBRAL_BASE_FISCAL=0.56
