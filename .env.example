# Copia este archivo a .env para desarrollo local (NUNCA subas .env al repo,
# ya esta en .gitignore). En Railway, estas mismas variables se configuran
# en Settings > Variables del servicio, no en un archivo.

# --- WhatsApp / Meta ---
# VERIFY_TOKEN es un valor que tu mismo inventas (ver conversacion del caso
# de estudio) -- debe coincidir con lo que escribas en el formulario de
# configuracion del webhook en Meta for Developers.
VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_TOKEN_ID=

# App Secret de tu app en Meta for Developers (Configuracion > Basica >
# Clave secreta de la aplicacion). Sirve para validar que cada POST al
# webhook realmente venga de Meta (ver _firma_valida en app/main.py).
# Opcional por compatibilidad: si se deja vacio, el webhook sigue
# funcionando pero sin validar la firma (queda un aviso en el log).
WHATSAPP_APP_SECRET=

# --- Groq (modelo conversacional + Llama Guard) ---
GROQ_API_KEY=
# Opcionales: si se omiten, se usan los defaults en app/config.py.
# Groq decomisiona modelos periodicamente (ver console.groq.com/docs/deprecations);
# si en el futuro alguno de estos deja de existir, Groq respondera 400 Bad
# Request al llamarlo, y hay que actualizar el valor aqui (o el default en
# app/config.py) al modelo de reemplazo vigente.
MODELO_CONVERSACIONAL=openai/gpt-oss-20b
MODELO_LLAMA_GUARD=openai/gpt-oss-safeguard-20b

# --- Supabase / Postgres (RAG + estado) ---
# Usa la cadena de conexion "Session pooler" de Supabase, con la contrasena
# real sustituida (sin corchetes).
SUPABASE_DB_URL=

# --- Prompt Guard (opcional) ---
# Requiere aceptar la licencia del modelo en Hugging Face y generar un token
# de acceso. Si se deja vacio, el agente sigue funcionando solo con Llama Guard.
HF_TOKEN=

# --- Endpoint /metricas ---
# Token simple (tu mismo inventas uno, igual que VERIFY_TOKEN) para proteger
# el reporte de /metricas -- se manda como /metricas?token=.... Opcional por
# compatibilidad: si se deja vacio, /metricas sigue siendo publico (queda un
# aviso en el log).
METRICAS_TOKEN=

# --- RAG ---
# Calibrado en el notebook original (0.56). Solo cambiar despues de correr
# scripts/evaluar_umbral.py con un contenido nuevo en DOCUMENTOS.
UMBRAL_BASE_FISCAL=0.56
